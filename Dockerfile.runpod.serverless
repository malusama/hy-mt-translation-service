# RunPod Serverless (Linux + NVIDIA GPU):
# - Inference: llama.cpp `llama-server` (GGUF)
# - API: Rust web (OpenAI-style + /imme|/translate|/detect)
# - RunPod glue: minimal Python handler (job input/output), no torch/transformers

FROM ghcr.io/ggml-org/llama.cpp:server-cuda AS llama_bin

FROM rust:1.91-bookworm AS rust_builder

WORKDIR /build

COPY rust-web/Cargo.toml rust-web/Cargo.lock /build/rust-web/
COPY rust-web/src /build/rust-web/src

RUN cargo build --release --manifest-path /build/rust-web/Cargo.toml

FROM runpod/base:0.6.1-cuda11.8.0

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    HF_HOME=/runpod-volume/hf

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libcurl4 \
  && rm -rf /var/lib/apt/lists/*

COPY builder/requirements.txt /requirements.txt
RUN python3.11 -m pip install --upgrade pip \
  && python3.11 -m pip install --no-cache-dir -r /requirements.txt \
  && rm /requirements.txt

COPY --from=llama_bin /app/ /opt/llama/
RUN ln -sf /opt/llama/llama-server /usr/local/bin/llama-server
ENV LD_LIBRARY_PATH="/opt/llama:${LD_LIBRARY_PATH}"
COPY --from=rust_builder /build/rust-web/target/release/hy-mt-rust-web /usr/local/bin/hy-mt-rust-web

COPY src/handler.py /src/handler.py
COPY scripts/runpod-serverless-entrypoint.sh /scripts/runpod-serverless-entrypoint.sh
RUN chmod +x /scripts/runpod-serverless-entrypoint.sh

CMD ["/scripts/runpod-serverless-entrypoint.sh"]
