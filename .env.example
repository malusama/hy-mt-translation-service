# Copy to `.env` and adjust as needed. Do NOT commit `.env`.

# Server
HOST=127.0.0.1
PORT=3000

# Optional request auth (clients send `Authorization: Bearer <API_KEY>` or `?token=...`)
# API_KEY=

# Model / backend
MODEL_ID=m-i/HY-MT1.5-1.8B-mlx-8Bit
BACKEND=auto
PRELOAD_MODEL=1
MAX_NEW_TOKENS=1024
TEMPERATURE=0
TOP_P=0.6
TOP_K=20
REPETITION_PENALTY=1.05
MODEL_MAX_CONCURRENCY=1
UVICORN_WORKERS=1

# Transformers backend options (Docker / Linux)
DEVICE=auto
DTYPE=auto

# Tip: On Linux you probably want:
# BACKEND=transformers
# MODEL_ID=tencent/HY-MT1.5-1.8B
