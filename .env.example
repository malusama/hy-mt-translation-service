# Copy to `.env` and adjust as needed. Do NOT commit `.env`.

# Server
HOST=127.0.0.1
PORT=3000

# Optional request auth (clients send `Authorization: Bearer <API_KEY>` or `?token=...`)
# API_KEY=

# Backend
# - macOS Apple Silicon recommended: BACKEND=mlx
# - Linux/Docker: BACKEND=transformers (CUDA/CPU)
# - GGUF/llama.cpp: use scripts/run-rust.sh
BACKEND=mlx

# MLX model (HuggingFace repo)
MODEL_ID=mlx-community/Hy-MT2-1.8B-4bit
# PRELOAD_MODEL=0
# UVICORN_WORKERS=1

# Model (GGUF / llama.cpp; only used by scripts/run-rust.sh)
# Download a GGUF file (e.g. from tencent/Hy-MT2-1.8B-GGUF) and set its local path here.
# MODEL_GGUF=./model/Hy-MT2-1.8B-Q4_K_M.gguf

# llama.cpp runtime knobs (optional)
# On macOS (Metal), you may want to build/run with: LLAMA_FEATURES=metal
# On Linux (NVIDIA CUDA), build/run with: LLAMA_FEATURES=cuda
# LLAMA_FEATURES=
# LLAMA_N_GPU_LAYERS=0
# LLAMA_N_CTX=0
# LLAMA_N_BATCH=512
# LLAMA_THREADS=0
# LLAMA_THREADS_BATCH=0

# Generation
MAX_NEW_TOKENS=1024
TEMPERATURE=0
TOP_P=0.6
TOP_K=20
REPETITION_PENALTY=1.05
MAX_INPUT_CHARS=2000
MODEL_MAX_CONCURRENCY=1
IMME_MAX_TEXTS=1024

# HTTP engine (BACKEND=http): any OpenAI-compatible chat-completions server.
# Measured faster than MLX on an M1 Pro for Hy-MT2-1.8B (llama.cpp + Metal).
#   llama-server -m model/Hy-MT2-1.8B-Q4_K_M.gguf -ngl 99 -c 4096 --port 18080
# BACKEND=http
# MODEL_HTTP_BASE_URL=http://127.0.0.1:18080
# MODEL_HTTP_MODEL=
# MODEL_HTTP_API_KEY=
# MODEL_HTTP_TIMEOUT=120

# Prompt wording: legacy (short, default) | official (Hy-MT2 model card)
PROMPT_STYLE=legacy

# ---- Router / shortlist -----------------------------------------------------
# Set ROUTER_ENABLED=0 to restore the pre-router behaviour exactly.
ROUTER_ENABLED=1
ROUTER_SKIP_SYMBOL_ONLY=1
# Identifiers / code / URLs / e-mails / versions: nothing to translate -> echo back
ROUTER_SKIP_UNTRANSLATABLE=1
ROUTER_SKIP_SAME_LANGUAGE=1
ROUTER_CACHE_SIZE=4096
ROUTER_RETRY=1

# Optional cascade fast path: a LinguaSpark/hy-mt compatible /imme service
# (e.g. marian-edge's 31M en->zh student on http://127.0.0.1:3000).
# ROUTER_FAST_URL=http://127.0.0.1:3000
ROUTER_FAST_PAIRS=en:zh
ROUTER_FAST_MAX_CHARS=240
ROUTER_FAST_TIMEOUT=30
# ROUTER_FAST_API_KEY=

# Translation memory / glossary (JSONL, optional, hot-loadable)
# SHORTLIST_PATH=./data/shortlist.jsonl
# GLOSSARY_PATH=./data/glossary.jsonl
SHORTLIST_TOP_K=5
SHORTLIST_REUSE=0.97
SHORTLIST_REFERENCE=0.80
SHORTLIST_REFERENCE_LIMIT=1
SHORTLIST_RERANK=off
GLOSSARY_LIMIT=8
